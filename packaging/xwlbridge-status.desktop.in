[Desktop Entry]
Type=Application
Name=VNC Server (Wayland desktop)
GenericName=Remote desktop sharing
Comment=RealVNC Server's status and options for this GNOME desktop (xwlbridge)
Exec=@BINDIR@/xwlbridge-ctl show
Icon=@ICON@
Terminal=false
Categories=Network;RemoteAccess;
Keywords=vnc;realvnc;remote;desktop;sharing;screen;
StartupNotify=false
