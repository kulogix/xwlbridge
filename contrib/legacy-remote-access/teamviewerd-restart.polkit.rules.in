// /etc/polkit-1/rules.d/50-xwlbridge-teamviewerd.rules (RHEL 10 and rebuilds; replace @USER@ with the desktop user)
// The desktop user may (try-)restart teamviewerd.service and nothing else, so the bridge's own unit can restart
// it whenever display :20 starts (xwlbridge-service-restart-teamviewerd.conf). TeamViewer-specific.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "teamviewerd.service" &&
        (action.lookup("verb") == "restart" || action.lookup("verb") == "try-restart") &&
        subject.user == "@USER@") {
        return polkit.Result.YES;
    }
});
